{
  "name": "text-to-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "check": "vite build",
    "smoke": "node scripts/smoke-electron.mjs",
    "smoke:ffmpeg": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-video.ps1",
    "voices:edge-samples": "node scripts/generate-edge-voice-samples.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^35.0.0",
    "node-edge-tts": "^1.2.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
